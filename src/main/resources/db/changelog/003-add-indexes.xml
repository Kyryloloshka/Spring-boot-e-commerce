<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-add-indexes" author="system">
        <!-- Index on product name for faster search -->
        <createIndex indexName="idx_products_name" tableName="products">
            <column name="name"/>
        </createIndex>

        <!-- Index on product category for filtering -->
        <createIndex indexName="idx_products_category" tableName="products">
            <column name="category"/>
        </createIndex>

        <!-- Index on cart total price for sorting -->
        <createIndex indexName="idx_carts_total_price" tableName="carts">
            <column name="total_price"/>
        </createIndex>

        <!-- Composite index on cart_items for cart queries -->
        <createIndex indexName="idx_cart_items_cart_id_product_id" tableName="cart_items">
            <column name="cart_id"/>
            <column name="product_id"/>
        </createIndex>

        <!-- Index on cart_id for cart item queries -->
        <createIndex indexName="idx_cart_items_cart_id" tableName="cart_items">
            <column name="cart_id"/>
        </createIndex>

        <!-- Index on product_id for product-based queries -->
        <createIndex indexName="idx_cart_items_product_id" tableName="cart_items">
            <column name="product_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
